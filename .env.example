# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is git-ignored.
#
# IMPORTANT: everything the app reads is built into the app and can be read by anyone who
# installs it. Only EXPO_PUBLIC_ settings that are safe to share belong here. API keys and
# wallet keys go in companion-server/.env.local instead (when the app has one).

# --- Wallet Connection ---
# Devnet RPC the app uses to build wallet payments. EXPO_PUBLIC_ values ship inside the app, so never put a key here (optional)
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Companion server ---
# Where the app finds companion-server/. Leave empty in development: the app uses the computer running `npm start`, port 3000. Set it to your deployed https:// URL for a release build. EXPO_PUBLIC_ values are built into the app, so never put a key here (optional)
EXPO_PUBLIC_COMPANION_URL=
