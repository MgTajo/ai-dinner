{
  "name": "ai-dinner-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx scripts/keygen.ts",
    "wallets": "tsx scripts/wallets.ts",
    "test:transfer": "tsx --test scripts/test-transfer.ts",
    "test:race": "tsx --test scripts/test-race.ts",
    "race:try": "tsx scripts/race-try.ts",
    "test:spending": "tsx --test scripts/test-spending.ts scripts/test-spending-x402.ts",
    "pay": "tsx examples/client.ts",
    "paysh": "tsx scripts/paysh.ts",
    "test:paysh": "tsx --test scripts/test-paysh.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
