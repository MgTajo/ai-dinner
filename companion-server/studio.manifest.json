{
  "scaffoldVersion": "0.13.1",
  "framework": "node",
  "modules": [
    "gemini",
    "payments",
    "race",
    "spending",
    "paidapi",
    "paysh"
  ],
  "autoAddedModules": [],
  "files": [
    ".env.example",
    ".gitignore",
    "README.md",
    "examples/client.ts",
    "package.json",
    "scripts/keygen.ts",
    "scripts/paysh.ts",
    "scripts/race-try.ts",
    "scripts/test-paysh.ts",
    "scripts/test-race.ts",
    "scripts/test-spending-x402.ts",
    "scripts/test-spending.ts",
    "scripts/test-transfer.ts",
    "scripts/wallets.ts",
    "src/landing.ts",
    "src/lib/ai/gemini.ts",
    "src/lib/paidapi/buyer.ts",
    "src/lib/payments/client.ts",
    "src/lib/payments/config.ts",
    "src/lib/payments/server.ts",
    "src/lib/payments/transfer.ts",
    "src/lib/paysh/listing.ts",
    "src/lib/spending/attach.ts",
    "src/lib/spending/policy.ts",
    "src/lib/spending/tracker.ts",
    "src/modules.ts",
    "src/race/adapter.ts",
    "src/race/handlers.ts",
    "src/race/memory.ts",
    "src/race/protocol.ts",
    "src/race/tools.ts",
    "src/routes/buy.ts",
    "src/routes/chat.ts",
    "src/routes/premium-data.ts",
    "src/routes/race.ts",
    "src/server.ts",
    "studio.manifest.json",
    "tsconfig.build.json",
    "tsconfig.json"
  ],
  "dependencies": {
    "@google/genai": "2.28.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx scripts/keygen.ts",
    "wallets": "tsx scripts/wallets.ts",
    "test:transfer": "tsx --test scripts/test-transfer.ts",
    "test:race": "tsx --test scripts/test-race.ts",
    "race:try": "tsx scripts/race-try.ts",
    "test:spending": "tsx --test scripts/test-spending.ts scripts/test-spending-x402.ts",
    "pay": "tsx examples/client.ts",
    "paysh": "tsx scripts/paysh.ts",
    "test:paysh": "tsx --test scripts/test-paysh.ts"
  },
  "env": [
    {
      "key": "GEMINI_API_KEY",
      "required": true,
      "secret": true,
      "module": "gemini"
    },
    {
      "key": "GEMINI_MODEL",
      "required": false,
      "secret": false,
      "module": "gemini"
    },
    {
      "key": "PAY_TO_ADDRESS",
      "required": true,
      "secret": false,
      "module": "payments"
    },
    {
      "key": "X402_NETWORK",
      "required": false,
      "secret": false,
      "module": "payments"
    },
    {
      "key": "X402_FACILITATOR_URL",
      "required": false,
      "secret": false,
      "module": "payments"
    },
    {
      "key": "AGENT_PRIVATE_KEY",
      "required": false,
      "secret": true,
      "module": "payments"
    },
    {
      "key": "SOLANA_RPC_URL",
      "required": false,
      "secret": false,
      "module": "payments"
    },
    {
      "key": "AGENT_STUDIO_VERIFIER_TOKEN",
      "required": true,
      "secret": true,
      "module": "race"
    },
    {
      "key": "AGENT_STUDIO_APP_NAME",
      "required": false,
      "secret": false,
      "module": "race"
    },
    {
      "key": "UPSTASH_REDIS_REST_URL",
      "required": false,
      "secret": false,
      "module": "race"
    },
    {
      "key": "UPSTASH_REDIS_REST_TOKEN",
      "required": false,
      "secret": true,
      "module": "race"
    },
    {
      "key": "AGENT_BUDGET_USD",
      "required": false,
      "secret": false,
      "module": "spending"
    },
    {
      "key": "MAX_PAYMENT_USD",
      "required": false,
      "secret": false,
      "module": "spending"
    },
    {
      "key": "PAID_API_PRICE_USD",
      "required": false,
      "secret": false,
      "module": "paidapi"
    },
    {
      "key": "PAYSH_SERVICE_URL",
      "required": false,
      "secret": false,
      "module": "paysh"
    }
  ],
  "prerequisites": [
    "Node.js 20.12 or newer (22 LTS recommended)",
    "Google account",
    "Gemini API key from Google AI Studio (free tier is enough)",
    "A Solana devnet address to receive test payments (PAY_TO_ADDRESS); `npm run keygen -- --pay-to` makes one",
    "To pay: a throwaway devnet keypair (`npm run keygen`) funded with devnet USDC from https://faucet.circle.com (no real money)",
    "The receiving address also needs a devnet USDC token account: send it faucet USDC once",
    "A team on Agent Studio (for the verifier token)",
    "A public https:// URL when you race (deploy, or a tunnel such as ngrok)",
    "The Pay.sh CLI: brew install pay, or npm install -g @solana/pay"
  ]
}
