  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@solana-mobile/mobile-wallet-adapter-protocol": "3.0.1",
    "@solana-mobile/mobile-wallet-adapter-protocol-kit": "3.0.1",
    "@solana/kit": "8.5.0",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.23",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1"
