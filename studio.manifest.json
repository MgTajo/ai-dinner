  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "build": "expo export --platform android",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "companion:install": "npm --prefix companion-server install",
    "companion": "npm --prefix companion-server run dev",
    "android:dev": "expo run:android"
  },
  "env": [
    {
      "key": "EXPO_PUBLIC_SOLANA_RPC_URL",
      "required": false,
      "secret": false,
      "module": "wallet"
    },
    {
      "key": "EXPO_PUBLIC_COMPANION_URL",
      "required": false,
      "secret": false,
      "module": "companion"
    }
  ],
  "prerequisites": [
    "Node.js 20.19.4 or newer (22 LTS recommended)",
    "A web browser (nothing else needed), or an Android phone with Expo Go, or an Android emulator",
    "A team on Agent Studio (for the verifier token)",
    "A public https:// URL for the companion server when you race (deploy it, or a tunnel such as ngrok)",
    "The Pay.sh CLI: brew install pay, or npm install -g @solana/pay",
    "Android Studio with an emulator, or an Android phone with USB debugging (a development build replaces Expo Go)",
    "A Solana wallet app with Mobile Wallet Adapter (Phantom, Solflare, Backpack, …) switched to devnet, holding devnet USDC from https://faucet.circle.com (no real money)",
    "companion-server: Node.js 20.12 or newer (22 LTS recommended)",
    "companion-server: Google account",
    "companion-server: Gemini API key from Google AI Studio (free tier is enough)",
    "companion-server: A Solana devnet address to receive test payments (PAY_TO_ADDRESS); `npm run keygen -- --pay-to` makes one",
    "companion-server: To pay: a throwaway devnet keypair (`npm run keygen`) funded with devnet USDC from https://faucet.circle.com (no real money)",
    "companion-server: The receiving address also needs a devnet USDC token account: send it faucet USDC once",
    "companion-server: A team on Agent Studio (for the verifier token)",
    "companion-server: A public https:// URL when you race (deploy, or a tunnel such as ngrok)",
    "companion-server: The Pay.sh CLI: brew install pay, or npm install -g @solana/pay"
  ],
  "companion": {
    "dir": "companion-server",
    "framework": "node",
    "modules": [
      "gemini",
      "payments",
      "race",
      "spending",
      "paidapi",
      "paysh"
    ],
    "env": [
      {
        "key": "GEMINI_API_KEY",
        "required": true,
        "secret": true,
        "module": "gemini"
      },
      {
        "key": "GEMINI_MODEL",
        "required": false,
        "secret": false,
        "module": "gemini"
      },
      {
        "key": "PAY_TO_ADDRESS",
        "required": true,
        "secret": false,
        "module": "payments"
      },
      {
        "key": "X402_NETWORK",
        "required": false,
        "secret": false,
        "module": "payments"
      },
      {
        "key": "X402_FACILITATOR_URL",
        "required": false,
        "secret": false,
        "module": "payments"
      },
      {
        "key": "AGENT_PRIVATE_KEY",
        "required": false,
        "secret": true,
        "module": "payments"
      },
      {
        "key": "SOLANA_RPC_URL",
        "required": false,
        "secret": false,
        "module": "payments"
      },
      {
        "key": "AGENT_STUDIO_VERIFIER_TOKEN",
        "required": true,
        "secret": true,
        "module": "race"
      },
      {
        "key": "AGENT_STUDIO_APP_NAME",
        "required": false,
        "secret": false,
        "module": "race"
      },
      {
        "key": "UPSTASH_REDIS_REST_URL",
        "required": false,
        "secret": false,
        "module": "race"
      },
      {
        "key": "UPSTASH_REDIS_REST_TOKEN",
        "required": false,
        "secret": true,
        "module": "race"
      },
      {
        "key": "AGENT_BUDGET_USD",
        "required": false,
        "secret": false,
        "module": "spending"
      },
      {
        "key": "MAX_PAYMENT_USD",
        "required": false,
        "secret": false,
        "module": "spending"
      },
      {
        "key": "PAID_API_PRICE_USD",
        "required": false,
        "secret": false,
        "module": "paidapi"
      },
      {
        "key": "PAYSH_SERVICE_URL",
        "required": false,
        "secret": false,
        "module": "paysh"
      }
    ]
  }
}
